# Copy to .env and fill in. Never commit .env.
# Times are always stored in UTC; APP_TIMEZONE is used for display only.

# Laravel
APP_NAME="Expat Lead Radar"
APP_ENV=local
APP_DEBUG=true
# Generate with: docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_URL=http://localhost:8080
APP_PORT=8080
APP_LOCALE=vi
APP_TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_DATABASE=leadradar
DB_USERNAME=leadradar
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_COLLATION=utf8mb4_unicode_ci
QUEUE_CONNECTION=redis
REDIS_HOST=redis
SESSION_DRIVER=database

# First admin (created by `php artisan migrate --seed`). Empty password = random, printed once.
ADMIN_EMAIL=admin@leadradar.local
ADMIN_PASSWORD=

# Internal security
INGEST_TOKEN=                # long random string shared with collectors

# Anthropic (Phase 2)
ANTHROPIC_API_KEY=
AI_MODEL_CLASSIFY=claude-haiku-5-5
AI_MODEL_ESCALATE=claude-sonnet-5-5
AI_MODEL_DRAFT=claude-sonnet-5-5
AI_DAILY_BUDGET_USD=5        # over budget: pause the ai queue and alert
AI_QUEUE_WORKERS=4

# Telegram bot for team notifications (Phase 2)
TG_BOT_TOKEN=
TG_TEAM_CHAT_ID=
NOTIFY_MIN_SCORE=60
QUIET_HOURS=23-07

# Telegram listener / collector (Phase 4)
TG_API_ID=
TG_API_HASH=
TG_SESSION_PATH=/data/telegram.session

# Apify (Phase 5)
APIFY_TOKEN=
APIFY_FB_ACTOR=apify/facebook-groups-scraper
FB_POLL_MINUTES=60

# Forum (Phase 5)
FORUM_POLL_MINUTES=60
FORUM_MAX_AGE_DAYS=7         # SPEC: threads updated in the last 7 days
CRAWLER_USER_AGENT="ExpatLeadRadar/1.0 (+mailto:ops@your-agency.example)"   # put a real contact address here

# Collectors -> app
INGEST_URL=http://app:8080/api
