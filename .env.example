# Copy to .env and fill in. Never commit .env.
# Times are always stored in UTC; APP_TIMEZONE is used for display only.

# Laravel
APP_NAME="Expat Lead Radar"
APP_ENV=production
APP_DEBUG=false
# deploy.sh fills it in; or: docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
# Your real HTTPS domain (photo links, links in drafts and Telegram, Mini App)
APP_URL=https://radar.example.com
# Host port the container is published on. Keep 127.0.0.1 so only nginx can reach it;
# pick any free port if 8080 is taken, e.g. 127.0.0.1:18080
APP_PORT=127.0.0.1:8080
APP_LOCALE=vi
APP_TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_DATABASE=leadradar
DB_USERNAME=leadradar
DB_PASSWORD=                 # deploy.sh fills it in if empty
DB_ROOT_PASSWORD=            # deploy.sh fills it in if empty
DB_COLLATION=utf8mb4_unicode_ci
QUEUE_CONNECTION=redis
REDIS_HOST=redis
SESSION_DRIVER=database

# First admin (created by `php artisan migrate --seed`). Empty password = random, printed once.
ADMIN_EMAIL=admin@leadradar.local
ADMIN_PASSWORD=

# Internal security
INGEST_TOKEN=                # long random string shared with collectors (deploy.sh fills it in if empty)

# Collectors to run, comma-separated: forum,telegram,facebook. Empty = none (app only).
# telegram needs TG_API_ID/TG_API_HASH and a login first; facebook needs APIFY_TOKEN.
COMPOSE_PROFILES=

# Anthropic (Phase 2)
# auto: AI when the key is set and budget remains, keyword rules otherwise | ai | keyword (no key needed)
CLASSIFIER_MODE=auto
ANTHROPIC_API_KEY=
AI_MODEL_CLASSIFY=claude-haiku-5-5
AI_MODEL_ESCALATE=claude-sonnet-5-5
AI_MODEL_DRAFT=claude-sonnet-5-5
AI_DAILY_BUDGET_USD=5        # over budget: "ai" mode pauses the ai queue, "auto" switches to keywords; one alert
AI_QUEUE_WORKERS=4

# Telegram bot for team notifications (Phase 2)
TG_BOT_TOKEN=
TG_TEAM_CHAT_ID=
NOTIFY_MIN_SCORE=60
QUIET_HOURS=23-07              # empty = always notify at once
# Bot token / chat id can also be set on the dashboard (Settings > Thông báo Telegram); those win.

# Vietnamese tenants (owner decision 2026-11-11). false = drop Vietnamese posts (original SPEC).
PREFILTER_ACCEPT_VI=true

# App #2: public apartment site + Telegram Mini App (docs/APP2.md). APP_URL must be the real HTTPS domain.
SITE_ENABLED=true
SITE_DEFAULT_LOCALE=vi
INQUIRY_SCORE=100
INQUIRY_CONTACT_DAYS=90         # name/contact typed into the form are erased after this
INQUIRY_RATE_LIMIT=5            # requests per hour per IP
INQUIRY_MIN_FILL_SECONDS=3
TG_WEBAPP_MAX_AGE=86400

# Telegram listener / collector (Phase 4)
TG_API_ID=
TG_API_HASH=
TG_SESSION_PATH=/data/telegram.session

# Apify (Phase 5)
APIFY_TOKEN=
APIFY_FB_ACTOR=apify/facebook-groups-scraper
FB_POLL_MINUTES=60

# Forum (Phase 5)
FORUM_POLL_MINUTES=60
FORUM_MAX_AGE_DAYS=7         # SPEC: threads updated in the last 7 days
CRAWLER_USER_AGENT="ExpatLeadRadar/1.0 (+mailto:ops@your-agency.example)"   # put a real contact address here

# Collectors -> app
INGEST_URL=http://app:8080/api
