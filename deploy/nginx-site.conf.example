# nginx site for Expat Lead Radar (Docker app behind the host's nginx).
#
#   sudo cp deploy/nginx-site.conf.example /etc/nginx/sites-available/leadradar
#   sudo nano /etc/nginx/sites-available/leadradar      # change server_name and the port
#   sudo ln -s /etc/nginx/sites-available/leadradar /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d radar.example.com           # certbot adds the HTTPS part
#
# The port must match APP_PORT in .env (APP_PORT=127.0.0.1:8080 -> 127.0.0.1:8080 here).

server {
    listen 80;
    listen [::]:80;
    server_name radar.example.com;

    # Listing photos are uploaded from the dashboard (max 5 MB each, several at once).
    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # The app builds https:// links and secure cookies from this header.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;

        proxy_read_timeout 120s;
    }
}
