# Copy to .env.local (gitignored) for run-local.ps1. Never commit .env.local.

# Local Laravel app (php artisan serve) and the INGEST_TOKEN from app/.env
INGEST_URL=http://127.0.0.1:8000/api
INGEST_TOKEN=local-dev-token

# Telegram listener account: https://my.telegram.org > API development tools
TG_API_ID=
TG_API_HASH=
# Session file defaults to ..\data\telegram.session (gitignored)
# TG_SESSION_PATH=

# Expat.com: put a real contact address in the User-Agent
CRAWLER_USER_AGENT=ExpatLeadRadar/1.0 (+mailto:ops@your-agency.example)
FORUM_MAX_AGE_DAYS=7

# Facebook via Apify
APIFY_TOKEN=
APIFY_FB_ACTOR=apify/facebook-groups-scraper
